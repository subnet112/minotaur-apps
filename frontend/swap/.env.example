# Aggregator API URL. Leave unset to use the public default
# (https://api.minotaursubnet.com configured in vite.config.ts).
# Override for local dev against a locally-running validator + API:
#   VITE_API_URL=http://localhost:8000
VITE_API_URL=

# The App Intent this UI serves. The validator can list several apps (V1 and
# V2 DexAggregator during the migration); we serve exactly ONE, chosen
# explicitly — never the list head. Defaults to the DEX Aggregator V2 app
# (Base + Ethereum). A configured id the validator doesn't list is a hard
# error surfaced to the user (never a silent fallback).
#   VITE_APP_ID=app_0867cdd4effd
VITE_APP_ID=

# EVM RPC endpoints. Public fallbacks are used when unset, but Ethereum
# mainnet especially benefits from a dedicated RPC (Alchemy/Infura) for
# reliability. Base + Ethereum are both live for V2.
#   VITE_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>
#   VITE_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
VITE_ETH_RPC_URL=
VITE_BASE_RPC_URL=

# Bittensor subtensor WebSocket URL used by useWalletConnection.setupBittensorProxy.
# Default targets the public Finney mainnet endpoint.
# Override for a local subtensor:
#   VITE_BITTENSOR_WS_URL=ws://localhost:19944
VITE_BITTENSOR_WS_URL=wss://entrypoint-finney.opentensor.ai:443

# WalletConnect Cloud project ID — get one at https://cloud.walletconnect.com
# (free tier covers production usage). Without it, the RainbowKit connect
# modal logs a warning and WalletConnect-backed wallets (mobile wallets,
# Ledger Live, Trust, Rainbow mobile, etc.) won't appear; injected-only
# (MetaMask / Rabby / Brave) keeps working. Set before deploy.
#   VITE_WC_PROJECT_ID=<your-32-char-id>
VITE_WC_PROJECT_ID=
