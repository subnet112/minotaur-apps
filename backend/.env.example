# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated allowed CORS origins (the swap site). Use * to allow any.
ALLOWED_ORIGINS=https://app.minotaursubnet.com

# ─── Upstream validator API ─────────────────────────────────────────────────
# The BFF proxies non-cacheable calls (quotes, orders, writes) here and pulls
# shared read data (chains, apps, manifests) periodically into its cache.
VALIDATOR_API_URL=https://api.minotaursubnet.com
VALIDATOR_TIMEOUT_MS=25000

# ─── On-chain RPC (for the fast Multicall3 balances path) ────────────────────
# Browser-safe not required (this is server-side) — use a real dedicated RPC
# (Alchemy/Infura) for reliability; public fallbacks are used when unset.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org

# If true, when the Multicall3 balances path errors (bad RPC, unsupported
# chain) the request falls back to proxying the validator's /balances.
BALANCES_FALLBACK_TO_VALIDATOR=false

# ─── Cache tuning (milliseconds) ─────────────────────────────────────────────
# Shared reads: serve from cache for SHARED_TTL, then stale-while-revalidate up
# to SHARED_STALE while refreshing in the background. SHARED_REFRESH warms them
# periodically even with no traffic.
SHARED_TTL_MS=30000
SHARED_STALE_MS=300000
SHARED_REFRESH_MS=60000

# Token list (Superchain CDN) cache — changes slowly.
TOKEN_LIST_TTL_MS=3600000
SUPERCHAIN_TOKEN_LIST_URL=https://static.optimism.io/optimism.tokenlist.json

# Per-wallet balances cache (short; SWR keeps repeat views instant).
BALANCES_TTL_MS=15000
BALANCES_STALE_MS=60000
