{
  "name": "@minotaur/swap-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Backend-for-frontend for the Minotaur swap UI — caches shared validator data, computes wallet balances on-chain (Multicall3), and transparently proxies the rest. Offloads api.minotaursubnet.com and serves the site faster.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:tokens": "node scripts/sync-token-snapshots.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "viem": "^2.51.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.20"
    }
  }
}
